{
  "name": "@mozi-forge/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A foundation for self-evolving AI agents.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm -r run lint && oxlint src tests scripts",
    "test": "pnpm run build && pnpm -r run test:unit && pnpm run test:integration",
    "start": "pnpm run build && node dist/start.js",
    "check:pack": "node scripts/check-pack.mjs",
    "build:trainer": "pnpm -r run build",
    "test:integration": "vitest run tests/trainer.integration.test.ts tests/trainer-prompt.test.ts tests/pain.integration.test.ts tests/trainer.web.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.1.5-rc.2",
    "@mozi-forge/agent-test-plugin": "workspace:*",
    "@mozi-forge/human-request-plugin": "workspace:*",
    "@mozi-forge/trainer-agent": "workspace:*",
    "@mozi-forge/session-insights-plugin": "workspace:*",
    "@mozi-forge/review-agent": "workspace:*",
    "@mozi-forge/sleep-loop-plugin": "workspace:*",
    "@mozi-forge/agent-pain-plugin": "workspace:*",
    "@mozi-forge/reflect-loop-plugin": "workspace:*",
    "@mozi-forge/runtime": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-rc.2",
    "@types/node": "^24.3.0",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2"
  },
  "license": "Apache-2.0"
}
