{
  "name": "@mozi-forge/agent-test-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Isolated real-LLM evaluation runner for Harness agents.",
  "exports": {
    ".": "./dist/host.js",
    "./host": "./dist/host.js",
    "./tool": "./dist/tool.js",
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./metrics": "./dist/metrics.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json",
    "./inspection": "./dist/inspection.js",
    "./workcopy": "./dist/workcopy.js",
    "./runner": "./dist/runner.js",
    "./definition": "./dist/definition.js",
    "./session-client": "./dist/session-client.js"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test:unit": "vitest run tests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@mozi-forge/human-request-plugin": "workspace:*",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "ws": "8.21.0",
    "@mozi-forge/session-insights-plugin": "workspace:*",
    "@mozi-forge/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "esbuild": "0.28.2",
    "oxlint": "^1.12.0",
    "react": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/ws": "^8.18.1"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "prompts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozi-desk/mozi-forge.git",
    "directory": "packages/agent-test-plugin"
  },
  "publishConfig": {
    "access": "public"
  }
}
