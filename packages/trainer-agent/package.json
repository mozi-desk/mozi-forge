{
  "name": "@mozi-forge/trainer-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Evidence-driven Trainer Agent and human requirement workflow for Harness agents.",
  "exports": {
    ".": "./dist/host.js",
    "./host": "./dist/host.js",
    "./plugin": "./dist/plugin.js",
    "./types": "./dist/types.js",
    "./plan": "./dist/plan.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests",
    "test:unit": "vitest run tests"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@mozi-forge/agent-test-plugin": "workspace:*",
    "@mozi-forge/human-request-plugin": "workspace:*",
    "@deepseek-ai/dsh-util-values": "0.1.5-rc.2",
    "@mozi-forge/session-insights-plugin": "workspace:*",
    "@mozi-forge/agent-pain-plugin": "workspace:*",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "oxlint": "^1.12.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "prompts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozi-desk/mozi-forge.git",
    "directory": "packages/trainer-agent"
  },
  "publishConfig": {
    "access": "public"
  }
}
